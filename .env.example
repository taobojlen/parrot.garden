NUXT_BETTER_AUTH_SECRET=        # openssl rand -base64 32
NUXT_BETTER_AUTH_URL=http://localhost:3000
NUXT_EMAIL_FROM=noreply@example.com
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, build-time analytics configuration. Leave the key empty to disable.
POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Build-only source-map upload credentials (do not use NUXT_PUBLIC_).
# Use the PostHog API host for your region, not an ingestion-only proxy.
POSTHOG_CLI_HOST=
POSTHOG_CLI_PROJECT_ID=
# Personal API key with organization:read and error_tracking:write scopes.
POSTHOG_CLI_API_KEY=
